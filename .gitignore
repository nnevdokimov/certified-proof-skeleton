# Main-experiment release allowlist. Historical files remain locally archived.
# Add new maintained code here explicitly; never bulk-add the research workspace.
/*
!/docs/
!/experiments/
!/hpc/
!/release/
!/scripts/
!/src/
!/tests/
!/.gitignore
!/README.md
!/pytest.ini
!/requirements.txt

/docs/*
!/docs/ARTICLE1_REPRODUCIBILITY.md

/experiments/*
!/experiments/article1/

/experiments/article1/*
!/experiments/article1/native_holdout_commitments/

/experiments/article1/native_holdout_commitments/*
!/experiments/article1/native_holdout_commitments/POI_9b084d00533835e2b000a1ae07d4627f14bc7083df75bb35d6a36b703497f064.json
!/experiments/article1/native_holdout_commitments/POI_9b084d00533835e2b000a1ae07d4627f14bc7083df75bb35d6a36b703497f064_technical_repair_of_13d60bb2af56b5e33681e26ca334e0925f7360fcd5a7b839a1027b451db26407.json

